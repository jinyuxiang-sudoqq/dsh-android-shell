<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH 手机外壳。

  两个刻意的选择：

  1. 不申请任何多余权限，只要 INTERNET。这个壳不做别的事。

  2. 明文 HTTP 只在 127.0.0.1 / localhost 上放行（见 network_security_config.xml）。
     不用 android:usesCleartextTraffic="true" —— 那等于全网络放行明文，
     而这里只需要跟本机的一个回环服务说话。DSH 只监听回环，所以够用且更紧。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.mobile">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 声明一下：这个应用是给手机用的，但也能装到平板/电视上 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          外壳自己的设置页（开机动画等）。

          android:theme 指定同一个 AppTheme：设置页也要深色 + 透明状态栏，
          否则从 DSH 界面进来会闪一下白底。
        -->
        <activity
            android:name=".MobileSettingsActivity"
            android:exported="false"
            android:label="设置"
            android:theme="@style/AppTheme" />
    </application>
</manifest>
